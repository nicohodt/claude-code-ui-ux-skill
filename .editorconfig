; Keeps CSV line endings and indentation consistent across contributors.
; The asset-sync check compares normalised content, but a diff full of line
; ending churn makes a one-row CSV PR unreviewable.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
; Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.csv]
; Never reflow or strip CSV content — cells legitimately contain trailing
; spaces inside quoted values.
trim_trailing_whitespace = false
insert_final_newline = true

[Makefile]
indent_style = tab
